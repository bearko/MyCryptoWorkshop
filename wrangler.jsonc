{
  "name": "mycryptoworkshop",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.ts",
  "assets": {
    // Built by `npm run build` (vite) before deploy
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker code; everything else is served straight from dist/
    "run_worker_first": ["/api/*"]
  },
  // 本番以外のブランチ（プレビュー）のビルドで `wrangler preview` を使うために必要。
  // 空なので、プレビューには本番の D1・変数・シークレットはつながらない（本番のデータに書き込まない）
  "previews": {}
}
